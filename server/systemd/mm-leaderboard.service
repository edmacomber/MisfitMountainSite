[Unit]
Description=Misfit Monsters Leaderboard + Telemetry API
After=network.target

[Service]
Type=simple
User=claudecode
Group=claudecode
WorkingDirectory=/opt/MisfitMountainSite/server
Environment=MM_DB_PATH=/var/www/mm-leaderboard/scores.db
ExecStart=/var/www/mm-leaderboard/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8001 --workers 1
Restart=on-failure
RestartSec=3
# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/mm-leaderboard

[Install]
WantedBy=multi-user.target
